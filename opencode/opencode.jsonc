{
  // API keys come from ~/.dotfiles/secrets.zsh (template: secrets-dist.zsh).
  // Secrets: MULTI_MODEL_GATEWAY_API_KEY, DEEPSEEK_CODING_PLAN_API_KEY, KANEO_API_KEY, KANEO_WORKSPACE_ID.
  // ClickUp and Figma use their official remote MCPs (OAuth: opencode mcp auth <name>).
  "$schema": "https://opencode.ai/config.json",
  "model": "multi-model-gateway/deepseek-flash",
  "small_model": "multi-model-gateway/deepseek-flash",
  "provider": {
    "multi-model-gateway": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Multi-Model Gateway",
      "options": {
        "baseURL": "https://multi-api.deepseekv4pro.com/v1",
        "apiKey": "{env:MULTI_MODEL_GATEWAY_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "mimo-flash": {
          "name": "MiMo V2.6 Flash",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off": {
              "reasoningEffort": "none"
            },
            "on": {
              "reasoningEffort": "high"
            }
          }
        },
        "mimo-pro": {
          "name": "MiMo V2.6 Pro",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off": {
              "reasoningEffort": "none"
            },
            "on": {
              "reasoningEffort": "high"
            }
          }
        },
        "glm-5.3": {
          "name": "GLM-5.3",
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": false,
          "reasoning": true,
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "kimi-k3": {
          "name": "Kimi-K3",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "max"
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "xhigh"
          },
          "variants": {
            "off": {
              "reasoningEffort": "none"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        },
        "minimax-m3": {
          "name": "MiniMax M3",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "off": {
              "reasoningEffort": "none"
            },
            "on": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
    "deepseek-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek Coding Plan",
      "options": {
        "baseURL": "https://api.deepseekv4pro.com/v1",
        "apiKey": "{env:DEEPSEEK_CODING_PLAN_API_KEY}"
      },
      "models": {
        "deepseek-flash": { "name": "DeepSeek Flash 1017", "reasoning": true, "interleaved": { "field": "reasoning_content" } },
        "deepseek-v4-flash": { "name": "DeepSeek V4 Flash", "reasoning": true, "interleaved": { "field": "reasoning_content" } },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro", "reasoning": true, "interleaved": { "field": "reasoning_content" } },
        "deepseek-v4-flash-vision-exp": { "name": "DeepSeek V4 Flash Vision Exp", "reasoning": true, "interleaved": { "field": "reasoning_content" } }
      }
    }
  },
  "mcp": {
    "servers": {
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      },
      "clickup": {
        "type": "remote",
        "url": "https://mcp.clickup.com/mcp"
      },
      "kaneo": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@sadamdi/kaneo-mcp",
          "serve"
        ],
        "environment": {
          "KANEO_API_KEY": "{env:KANEO_API_KEY}",
          "KANEO_WORKSPACE_ID": "{env:KANEO_WORKSPACE_ID}"
        }
      }
    }
  }
}
