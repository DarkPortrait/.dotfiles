# Shared git config. Identity is per machine: GIT_AUTHOR_* / GIT_COMMITTER_*
# come from ~/.dotfiles/secrets.zsh. With no user.signingkey, git signs with the
# gpg key matching the committer email.
[core]
	editor = vim
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
[web]
	browser = google-chrome
[commit]
	gpgsign = true
[push]
	default = current
	autoSetupRemote = true
